{
  "name": "sport-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/db-provider.mjs && prisma generate && next build",
    "start": "next start",
    "prod": "pnpm build && next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "db:push": "node scripts/db-provider.mjs && prisma db push",
    "db:migrate-users": "node --no-warnings --import tsx scripts/migrate-multiuser.mts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/db-provider.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "date-fns": "^4.1.0",
    "geist": "^1.7.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
