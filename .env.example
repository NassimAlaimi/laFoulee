# --- Base de données ---
# sqlite (local, fichier) ou postgresql (déploiement partagé)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# --- Strava API ---
# 1. Va sur https://www.strava.com/settings/api
# 2. Crée une application (Authorization Callback Domain = localhost en dev,
#    ou ton domaine de prod, ex. dcinema.swagman.fr)
# 3. Copie Client ID et Client Secret ici
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# En production (derrière le reverse proxy Caddy, voir DEPLOY.md) :
#   STRAVA_REDIRECT_URI="https://dcimer.swagman.fr/api/strava/callback"
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"

# Webhook Strava (révocations et suppressions d'activités — obligatoire pour
# respecter la politique API Strava ; procédure dans DEPLOY.md § Webhook Strava)
# Jeton libre, choisi par toi (openssl rand -hex 16)
STRAVA_WEBHOOK_VERIFY_TOKEN=""
# Identifiant renvoyé par Strava à la création de l'abonnement (facultatif, filtre)
STRAVA_WEBHOOK_SUBSCRIPTION_ID=""

# Clé de chiffrement des tokens Strava au repos (génère : openssl rand -hex 32)
TOKEN_SECRET=""

# --- Authentification ---
# Secret de signature des sessions. Génère-le avec : openssl rand -hex 32
AUTH_SECRET=""
# Qui peut créer un compte sur cette instance ?
# Vide = ouvert à tous. Sinon, liste d'identifiants athlète Strava séparés par des virgules.
ALLOWED_ATHLETES=""
# Code d'invitation exigé à la première connexion (vide = pas de code)
INVITE_CODE=""

# --- Mentions légales (affichées sur /legal et /privacy) ---
# Nom (ou nom + prénom) de la personne qui publie l'instance
LEGAL_PUBLISHER=""
# Adresse de contact pour les questions sur les données
LEGAL_CONTACT=""
# Hébergeur : nom, adresse, téléphone (ex. « OVH SAS, 2 rue Kellermann, 59100 Roubaix, 1007 »)
# ou « Serveur personnel de l'éditeur, en France » s'il est auto-hébergé
LEGAL_HOST=""

# --- App ---
# URL publique de l'instance. Doit correspondre au domaine réellement utilisé :
# elle sert aux redirections OAuth et détermine si le cookie de session porte
# le flag Secure (activé uniquement en https://).
# En production derrière Caddy : "https://dcimer.swagman.fr" (sans port).
# ⚠️ Variable NEXT_PUBLIC_* : inlinée au build, un `pnpm build` est requis après
# toute modification.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Profil athlète (utilisé pour les zones FC) ---
# Laisse vide pour estimation automatique (220 - âge)
ATHLETE_MAX_HR=""
ATHLETE_REST_HR="55"
